# Firecracker Workspace Service - Security Configuration
# Copy this to .env and customize with your settings

# ============================================
# API Key Authentication
# ============================================
# Enable API key authentication (REQUIRED for internet exposure)
API_KEY_ENABLED=true

# Your secret API key(s) - comma-separated for multiple keys
# Generate a strong key: openssl rand -hex 32
API_KEYS=your-secret-key-here

# HTTP header name for API key (default: X-API-Key)
API_KEY_HEADER=X-API-Key

# ============================================
# Rate Limiting
# ============================================
# Enable rate limiting (recommended: true)
RATE_LIMIT_ENABLED=true

# Maximum requests per time window
RATE_LIMIT_REQUESTS=100

# Time window in seconds
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================
# Request Size Limits
# ============================================
# Maximum request size in bytes (default: 10MB)
MAX_REQUEST_SIZE_BYTES=10485760

# ============================================
# Path Security
# ============================================
# Allowed path prefixes for file operations (comma-separated)
ALLOWED_PATH_PREFIXES=/workspace,/tmp

# ============================================
# CORS (if using web clients)
# ============================================
# Allowed origins (comma-separated, use * to allow all)
CORS_ORIGINS=*
